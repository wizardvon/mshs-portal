rules_version = '2'; 
 
service cloud.firestore { 
  match /databases/{database}/documents { 
    function registrationPath() { 
      return /databases/$(database)/documents/system/registration; 
    } 
 
    function signedIn() { 
      return request.auth != null; 
    } 
 
    function currentProfile() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)); 
    } 
 
    function isApprovedAdmin() { 
      return signedIn() 
        && currentProfile().data.status == "approved" 
        && currentProfile().data.role in ["super_admin", "admin"]; 
    } 
 
    function isSuperAdmin() { 
      return signedIn() 
        && currentProfile().data.status == "approved" 
        && currentProfile().data.role == "super_admin"; 
    } 

    function isApprovedUser() {
      return signedIn()
        && currentProfile().data.status == "approved";
    }

    function isDllReviewer() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "admin", "principal", "master_teacher"];
    }

    function canManageDllRequests() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "master_teacher"];
    }

    function isMpsReviewer() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "principal", "master_teacher"];
    }

    function isTosiaReviewer() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "admin", "principal", "master_teacher"];
    }

    function canSubmitForTeacher(teacherId) {
      return isApprovedUser()
        && currentProfile().data.role in ["teacher", "master_teacher"]
        && (
          currentProfile().data.assignedTeacherId == teacherId
          || request.auth.uid == teacherId
        );
    }

    function canSubmitGradeForAssignment(data) {
      let assignment = get(/databases/$(database)/documents/loadAssignments/$(data.assignmentId)).data;
      return canSubmitForTeacher(data.teacherId)
        && assignment.teacherId == data.teacherId
        && assignment.schoolYear == data.schoolYear
        && assignment.term == data.term
        && assignment.subjectId == data.subjectId
        && assignment.sectionId == data.sectionId;
    }

    function canSubmitGradeSettingsForAssignment(data) {
      let assignment = get(/databases/$(database)/documents/loadAssignments/$(data.assignmentId)).data;
      return canSubmitForTeacher(data.teacherId)
        && assignment.teacherId == data.teacherId
        && assignment.schoolYear == data.schoolYear
        && assignment.term == data.term
        && assignment.subjectId == data.subjectId
        && assignment.sectionId == data.sectionId;
    }

    function canViewGradeSummary(data) {
      return isApprovedUser()
        && (
          currentProfile().data.role in ["super_admin", "principal", "master_teacher"]
          || currentProfile().data.advisingSectionId == data.sectionId
        );
    }

    function isObservationReviewer() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "principal", "master_teacher"];
    }

    function canManagePersonnelAttendance() {
      return isApprovedUser()
        && currentProfile().data.role in [
          "super_admin",
          "admin",
          "administrative_officer",
          "administrative_assistant"
        ];
    }

    function canManageEnrollment() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "admin", "registrar"];
    }

    function canUseDocumentRequests() {
      return isApprovedUser()
        && (
          currentProfile().data.role == "super_admin"
          || currentProfile().data.modulePermissions.hasAny(["document_requests"])
        );
    }

    function isAnnouncementManager() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "admin"];
    }

    function canReadAnnouncementData(data) {
      return isApprovedUser()
        && (
          isAnnouncementManager()
          || data.postedByUid == request.auth.uid
          || (
            data.authorizedUserIds is list
            && request.auth.uid in data.authorizedUserIds
          )
        );
    }
 
    function isBootstrapSuperAdmin(userId) { 
      return signedIn() 
        && request.auth.uid == "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        && userId == "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        && request.resource.data.email == "wizardvon@gmail.com"; 
    } 
 
    function validUserBase(userId) { 
      return signedIn() 
        && request.auth.uid == userId 
        && request.resource.data.userId == userId 
        && request.resource.data.email is string 
        && request.resource.data.fullName is string 
        && validUserRole(request.resource.data.role)
        && validModulePermissions()
        && request.resource.data.createdAt == request.time 
        && request.resource.data.keys().hasOnly([ 
          "userId", 
          "fullName", 
          "email", 
          "role", 
          "status", 
          "modulePermissions",
          "createdAt" 
        ]); 
    } 
 
    function validFirstUser(userId) { 
      return validUserBase(userId) 
        && !exists(registrationPath()) 
        && request.resource.data.role == "super_admin" 
        && request.resource.data.status == "approved"; 
    } 
 
    function validBootstrapUser(userId) { 
      return signedIn() 
        && isBootstrapSuperAdmin(userId) 
        && request.resource.data.userId == userId 
        && request.resource.data.fullName is string 
        && request.resource.data.createdAt is timestamp 
        && request.resource.data.role == "super_admin" 
        && request.resource.data.status == "approved" 
        && validModulePermissions()
        && request.resource.data.keys().hasOnly([ 
          "userId", 
          "fullName", 
          "email", 
          "role", 
          "status", 
          "modulePermissions",
          "createdAt" 
        ]); 
    } 
 
    function validPendingUser(userId) { 
      return validUserBase(userId) 
        && exists(registrationPath()) 
        && request.resource.data.role in [
          "principal",
          "master_teacher",
          "teacher",
          "registrar",
          "administrative_officer",
          "administrative_assistant",
          "admin"
        ] 
        && request.resource.data.status == "pending"; 
    } 
 
    function validRegistrationCreate() { 
      return signedIn() 
        && !exists(registrationPath()) 
        && request.resource.data.userCount == 1 
        && request.resource.data.firstSuperAdminId in [ 
          request.auth.uid, 
          "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        ] 
        && request.resource.data.updatedAt == request.time 
        && request.resource.data.keys().hasOnly([ 
          "userCount", 
          "firstSuperAdminId", 
          "updatedAt" 
        ]); 
    } 
 
    function validRegistrationUpdate() { 
      return signedIn() 
        && exists(registrationPath()) 
        && ( 
          request.resource.data.userCount == resource.data.userCount + 1 
          || ( 
            request.auth.uid == "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
            && request.resource.data.userCount == resource.data.userCount 
          ) 
        ) 
        && request.resource.data.firstSuperAdminId in [ 
          resource.data.firstSuperAdminId, 
          "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        ] 
        && request.resource.data.updatedAt == request.time 
        && request.resource.data.keys().hasOnly([ 
          "userCount", 
          "firstSuperAdminId", 
          "updatedAt" 
        ]); 
    } 

    function validOptionalString(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is string;
    }

    function validOptionalTerm(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] in ["1st Term", "2nd Term", "3rd Term"];
    }

    function validOptionalBool(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is bool;
    }

    function validOptionalTimestamp(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is timestamp;
    }

    function validNotificationToken(userId, tokenId) {
      return request.resource.data.tokenId == tokenId
        && request.resource.data.userId == userId
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.userAgent is string
        && request.resource.data.platform is string
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "tokenId",
          "token",
          "userId",
          "userAgent",
          "platform",
          "enabled",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validNotificationCreate(userId, notificationId) {
      return request.resource.data.notificationId == notificationId
        && request.resource.data.userId == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 600
        && validOptionalString("href")
        && request.resource.data.audience in [
          "all",
          "principal",
          "master_teacher",
          "teacher",
          "registrar",
          "administrative_officer",
          "administrative_assistant",
          "admin",
          "super_admin",
          "user"
        ]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.creatorName is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          "notificationId",
          "userId",
          "title",
          "body",
          "href",
          "audience",
          "createdBy",
          "creatorName",
          "read",
          "createdAt"
        ]);
    }

    function validNotificationReadUpdate(userId, notificationId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid == userId
        && request.resource.data.notificationId == notificationId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.get("href", "") == resource.data.get("href", "")
        && request.resource.data.audience == resource.data.audience
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time
        && changedKeys.hasOnly(["read", "readAt"]);
    }

    function validUserRole(role) {
      return role in [
        "principal",
        "master_teacher",
        "teacher",
        "registrar",
        "administrative_officer",
        "administrative_assistant",
        "admin",
        "super_admin"
      ];
    }

    function validModulePermissions() {
      return request.resource.data.modulePermissions is list
        && request.resource.data.modulePermissions.size() <= 29
        && request.resource.data.modulePermissions.hasOnly([
          "dashboard",
          "announcements",
          "loading",
          "teachers",
          "subjects",
          "sections",
          "enrollment",
          "curriculum_mapping",
          "load_assignment",
          "scheduler",
          "dll_submissions",
          "document_requests",
          "tosia_pro",
          "mps",
          "grade_computation",
          "grade_submissions",
          "grade_summary",
          "observations",
          "personnel_attendance",
          "personnel_locator",
          "my_personnel_attendance",
          "teacher_loads",
          "certificates",
          "printable_certificates",
          "reports",
          "personnel_settings",
          "settings",
          "backup_restore",
          "users"
        ]);
    }

    function validAnnouncementSort(data) {
      return (
          data.isPinned == false
          && (
            (data.priority == "normal" && data.sortRank == 1)
            || (data.priority == "important" && data.sortRank == 2)
            || (data.priority == "urgent" && data.sortRank == 3)
          )
        ) || (
          data.isPinned == true
          && (
            (data.priority == "normal" && data.sortRank == 11)
            || (data.priority == "important" && data.sortRank == 12)
            || (data.priority == "urgent" && data.sortRank == 13)
          )
        );
    }

    function validAnnouncementBase(announcementId) {
      return request.resource.data.keys().hasOnly([
          "announcementId",
          "title",
          "source",
          "message",
          "audienceType",
          "audienceIds",
          "audienceNames",
          "targetUserIds",
          "authorizedUserIds",
          "category",
          "priority",
          "postedByUid",
          "postedByName",
          "status",
          "sortRank",
          "isPinned",
          "isArchived",
          "requireAcknowledgment",
          "attachments",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.announcementId == announcementId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 300
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 20000
        && request.resource.data.audienceType in [
          "all_personnel",
          "teaching_personnel",
          "non_teaching_personnel",
          "department",
          "grade_level",
          "selected_personnel",
          "selected_group"
        ]
        && request.resource.data.audienceIds is list
        && request.resource.data.audienceIds.size() <= 1000
        && request.resource.data.audienceNames is list
        && request.resource.data.audienceNames.size() > 0
        && request.resource.data.audienceNames.size() <= 1000
        && request.resource.data.targetUserIds is list
        && request.resource.data.targetUserIds.size() <= 1000
        && request.resource.data.authorizedUserIds is list
        && request.resource.data.authorizedUserIds.size() > 0
        && request.resource.data.authorizedUserIds.size() <= 1001
        && request.resource.data.authorizedUserIds.hasAny([request.resource.data.postedByUid])
        && request.resource.data.authorizedUserIds.hasAll(request.resource.data.targetUserIds)
        && request.resource.data.authorizedUserIds.size() <= request.resource.data.targetUserIds.size() + 1
        && request.resource.data.category in [
          "memorandum",
          "advisory",
          "meeting",
          "activity_event",
          "deadline_submission",
          "information",
          "other"
        ]
        && request.resource.data.priority in ["normal", "important", "urgent"]
        && request.resource.data.postedByUid is string
        && request.resource.data.postedByName is string
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.isPinned is bool
        && request.resource.data.isArchived is bool
        && request.resource.data.requireAcknowledgment is bool
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() <= 20
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && validAnnouncementSort(request.resource.data)
        && (
          request.resource.data.status == "draft"
          || request.resource.data.targetUserIds.size() > 0
        );
    }

    function validAnnouncementCreate(announcementId) {
      return isApprovedUser()
        && validAnnouncementBase(announcementId)
        && request.resource.data.postedByUid == request.auth.uid
        && request.resource.data.postedByName == currentProfile().data.fullName
        && request.resource.data.status == "draft"
        && request.resource.data.isPinned == false
        && request.resource.data.isArchived == false
        && request.resource.data.attachments.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAnnouncementOwnerUpdate(announcementId) {
      return validAnnouncementBase(announcementId)
        && resource.data.postedByUid == request.auth.uid
        && request.resource.data.postedByUid == resource.data.postedByUid
        && request.resource.data.postedByName == resource.data.postedByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isPinned == resource.data.isPinned
        && request.resource.data.status == "published"
        && request.resource.data.updatedAt == request.time;
    }

    function validAnnouncementManagerUpdate(announcementId) {
      return validAnnouncementBase(announcementId)
        && request.resource.data.postedByUid == resource.data.postedByUid
        && request.resource.data.postedByName == resource.data.postedByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.status == "published"
        && request.resource.data.updatedAt == request.time;
    }

    function announcementForRead(data) {
      return get(/databases/$(database)/documents/announcements/$(data.announcementId));
    }

    function canReadAnnouncementRead(data) {
      let announcement = announcementForRead(data);
      return isApprovedUser()
        && (
          data.userId == request.auth.uid
          || isAnnouncementManager()
          || announcement.data.postedByUid == request.auth.uid
        );
    }

    function validAnnouncementReadCreate(readId) {
      let announcement = announcementForRead(request.resource.data);
      return isApprovedUser()
        && request.resource.data.keys().hasAll([
          "readId",
          "announcementId",
          "userId",
          "userName",
          "firstReadAt"
        ])
        && request.resource.data.keys().hasOnly([
          "readId",
          "announcementId",
          "userId",
          "userName",
          "firstReadAt",
          "acknowledgedAt"
        ])
        && request.resource.data.readId == readId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName == currentProfile().data.fullName
        && readId == request.resource.data.announcementId + "_" + request.auth.uid
        && announcement.data.status == "published"
        && announcement.data.targetUserIds.hasAny([request.auth.uid])
        && request.resource.data.firstReadAt == request.time
        && (
          !request.resource.data.keys().hasAny(["acknowledgedAt"])
          || (
            announcement.data.requireAcknowledgment == true
            && request.resource.data.acknowledgedAt == request.time
          )
        );
    }

    function validAnnouncementReadUpdate() {
      let announcement = announcementForRead(resource.data);
      return isApprovedUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["acknowledgedAt"])
        && announcement.data.requireAcknowledgment == true
        && announcement.data.targetUserIds.hasAny([request.auth.uid])
        && request.resource.data.acknowledgedAt == request.time;
    }

    function validGradeComputationWeights() {
      return request.resource.data.weights is map
        && request.resource.data.weights.keys().hasOnly(["written", "performance", "exam"])
        && request.resource.data.weights.written is number
        && request.resource.data.weights.performance is number
        && request.resource.data.weights.exam is number
        && request.resource.data.weights.written >= 0
        && request.resource.data.weights.performance >= 0
        && request.resource.data.weights.exam >= 0
        && request.resource.data.weights.written + request.resource.data.weights.performance + request.resource.data.weights.exam == 100;
    }

    function validGradeComputationHighestScores() {
      let scores = request.resource.data.highestScores;
      let written = scores.written;
      let performance = scores.performance;
      let exam = scores.exam;
      return scores is map
        && scores.keys().hasOnly(["written", "performance", "exam"])
        && written is map
        && written.keys().hasOnly(["ww1", "ww2", "ww3", "ww4", "ww5"])
        && written.keys().hasAll(["ww1", "ww2", "ww3", "ww4", "ww5"])
        && written.ww1 is number && written.ww1 > 0
        && written.ww2 is number && written.ww2 > 0
        && written.ww3 is number && written.ww3 > 0
        && written.ww4 is number && written.ww4 > 0
        && written.ww5 is number && written.ww5 > 0
        && performance is map
        && performance.keys().hasOnly(["pt1", "pt2", "pt3"])
        && performance.keys().hasAll(["pt1", "pt2", "pt3"])
        && performance.pt1 is number && performance.pt1 > 0
        && performance.pt2 is number && performance.pt2 > 0
        && performance.pt3 is number && performance.pt3 > 0
        && exam is map
        && exam.keys().hasOnly(["s1", "s2", "tt"])
        && exam.keys().hasAll(["s1", "s2", "tt"])
        && exam.s1 is number && exam.s1 > 0
        && exam.s2 is number && exam.s2 > 0
        && exam.tt is number && exam.tt > 0;
    }

    function validGradeComputationComponent(component) {
      return component is map
        && component.keys().hasOnly(["score", "maxScore", "percentageScore", "weightedScore", "itemScores"])
        && component.score is number
        && component.maxScore is number
        && component.percentageScore is number
        && component.weightedScore is number
        && component.score >= 0
        && component.maxScore > 0
        && component.percentageScore >= 0
        && component.weightedScore >= 0;
    }

    function validGradeComputationItemScores() {
      let written = request.resource.data.written.itemScores;
      let performance = request.resource.data.performance.itemScores;
      let exam = request.resource.data.exam.itemScores;
      return written is map
        && written.keys().hasOnly(["ww1", "ww2", "ww3", "ww4", "ww5"])
        && written.keys().hasAny(["ww1", "ww2", "ww3", "ww4", "ww5"])
        && performance is map
        && performance.keys().hasOnly(["pt1", "pt2", "pt3"])
        && performance.keys().hasAny(["pt1", "pt2", "pt3"])
        && exam is map
        && exam.keys().hasOnly(["s1", "s2", "tt"])
        && exam.keys().hasAny(["s1", "s2", "tt"]);
    }

    function usesSavedGradeComputationSettings() {
      let settings = get(
        /databases/$(database)/documents/gradeComputationSettings/$(request.resource.data.assignmentId)
      ).data;
      return request.resource.data.weights == settings.weights
        && request.resource.data.highestScores == settings.highestScores;
    }

    function validGradeComputationBase(computationId) {
      return request.resource.data.computationId == computationId
        && computationId == request.resource.data.assignmentId + "__" + request.resource.data.enrollmentId
        && request.resource.data.classEnrollmentId is string
        && request.resource.data.enrollmentId is string
        && request.resource.data.lrn is string
        && request.resource.data.studentName is string
        && request.resource.data.teacherName is string
        && request.resource.data.subjectCode is string
        && request.resource.data.subjectName is string
        && request.resource.data.sectionName is string
        && request.resource.data.gradeLevel is string
        && request.resource.data.strand is string
        && usesSavedGradeComputationSettings()
        && validGradeComputationComponent(request.resource.data.written)
        && validGradeComputationComponent(request.resource.data.performance)
        && validGradeComputationComponent(request.resource.data.exam)
        && validGradeComputationItemScores()
        && request.resource.data.initialGrade is number
        && request.resource.data.initialGrade >= 0
        && request.resource.data.initialGrade <= 100
        && request.resource.data.finalGrade is number
        && request.resource.data.finalGrade >= 0
        && request.resource.data.finalGrade <= 100
        && request.resource.data.submittedBy == request.auth.uid
        && canSubmitGradeForAssignment(request.resource.data)
        && request.resource.data.keys().hasOnly([
          "computationId",
          "assignmentId",
          "classEnrollmentId",
          "enrollmentId",
          "lrn",
          "studentName",
          "schoolYear",
          "term",
          "teacherId",
          "teacherName",
          "subjectId",
          "subjectCode",
          "subjectName",
          "sectionId",
          "sectionName",
          "gradeLevel",
          "strand",
          "weights",
          "highestScores",
          "written",
          "performance",
          "exam",
          "initialGrade",
          "finalGrade",
          "submittedBy",
          "submittedAt",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validGradeComputationCreate(computationId) {
      return validGradeComputationBase(computationId)
        && request.resource.data.submittedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validGradeComputationUpdate(computationId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return validGradeComputationBase(computationId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "studentName",
          "teacherName",
          "subjectCode",
          "subjectName",
          "sectionName",
          "gradeLevel",
          "strand",
          "weights",
          "highestScores",
          "written",
          "performance",
          "exam",
          "initialGrade",
          "finalGrade",
          "submittedBy",
          "submittedAt",
          "updatedAt"
        ]);
    }


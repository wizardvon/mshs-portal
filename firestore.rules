rules_version = '2'; 
 
service cloud.firestore { 
  match /databases/{database}/documents { 
    function registrationPath() { 
      return /databases/$(database)/documents/system/registration; 
    } 
 
    function signedIn() { 
      return request.auth != null; 
    } 
 
    function currentProfile() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)); 
    } 
 
    function isApprovedAdmin() { 
      return signedIn() 
        && currentProfile().data.status == "approved" 
        && currentProfile().data.role in ["super_admin", "admin"]; 
    } 
 
    function isSuperAdmin() { 
      return signedIn() 
        && currentProfile().data.status == "approved" 
        && currentProfile().data.role == "super_admin"; 
    } 

    function isApprovedUser() {
      return signedIn()
        && currentProfile().data.status == "approved";
    }

    function isDllReviewer() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "admin", "principal", "master_teacher"];
    }

    function isMpsReviewer() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "principal", "master_teacher"];
    }

    function isTosiaReviewer() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "admin", "principal", "master_teacher"];
    }

    function canSubmitForTeacher(teacherId) {
      return isApprovedUser()
        && currentProfile().data.role in ["teacher", "master_teacher"]
        && (
          currentProfile().data.assignedTeacherId == teacherId
          || request.auth.uid == teacherId
        );
    }

    function canSubmitGradeForAssignment(data) {
      let assignment = get(/databases/$(database)/documents/loadAssignments/$(data.assignmentId)).data;
      let classEnrollment = get(/databases/$(database)/documents/classEnrollments/$(data.classEnrollmentId)).data;
      return canSubmitForTeacher(data.teacherId)
        && assignment.teacherId == data.teacherId
        && assignment.schoolYear == data.schoolYear
        && assignment.term == data.term
        && assignment.subjectId == data.subjectId
        && assignment.sectionId == data.sectionId
        && classEnrollment.enrollmentId == data.enrollmentId
        && classEnrollment.teacherId == data.teacherId
        && classEnrollment.schoolYear == data.schoolYear
        && classEnrollment.term == data.term
        && classEnrollment.subjectId == data.subjectId
        && classEnrollment.sectionId == data.sectionId
        && classEnrollment.lrn == data.lrn;
    }

    function canViewGradeSummary(data) {
      return isApprovedUser()
        && (
          currentProfile().data.role in ["super_admin", "principal", "master_teacher"]
          || currentProfile().data.advisingSectionId == data.sectionId
        );
    }

    function isObservationReviewer() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "principal", "master_teacher"];
    }

    function canManagePersonnelAttendance() {
      return isApprovedUser()
        && currentProfile().data.role in [
          "super_admin",
          "admin",
          "administrative_officer",
          "administrative_assistant"
        ];
    }

    function canManageEnrollment() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "admin", "registrar"];
    }

    function canUseDocumentRequests() {
      return isApprovedUser()
        && (
          currentProfile().data.role == "super_admin"
          || currentProfile().data.modulePermissions.hasAny(["document_requests"])
        );
    }
 
    function isBootstrapSuperAdmin(userId) { 
      return signedIn() 
        && request.auth.uid == "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        && userId == "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        && request.resource.data.email == "wizardvon@gmail.com"; 
    } 
 
    function validUserBase(userId) { 
      return signedIn() 
        && request.auth.uid == userId 
        && request.resource.data.userId == userId 
        && request.resource.data.email is string 
        && request.resource.data.fullName is string 
        && validUserRole(request.resource.data.role)
        && validModulePermissions()
        && request.resource.data.createdAt == request.time 
        && request.resource.data.keys().hasOnly([ 
          "userId", 
          "fullName", 
          "email", 
          "role", 
          "status", 
          "modulePermissions",
          "createdAt" 
        ]); 
    } 
 
    function validFirstUser(userId) { 
      return validUserBase(userId) 
        && !exists(registrationPath()) 
        && request.resource.data.role == "super_admin" 
        && request.resource.data.status == "approved"; 
    } 
 
    function validBootstrapUser(userId) { 
      return signedIn() 
        && isBootstrapSuperAdmin(userId) 
        && request.resource.data.userId == userId 
        && request.resource.data.fullName is string 
        && request.resource.data.createdAt is timestamp 
        && request.resource.data.role == "super_admin" 
        && request.resource.data.status == "approved" 
        && validModulePermissions()
        && request.resource.data.keys().hasOnly([ 
          "userId", 
          "fullName", 
          "email", 
          "role", 
          "status", 
          "modulePermissions",
          "createdAt" 
        ]); 
    } 
 
    function validPendingUser(userId) { 
      return validUserBase(userId) 
        && exists(registrationPath()) 
        && request.resource.data.role in [
          "principal",
          "master_teacher",
          "teacher",
          "registrar",
          "administrative_officer",
          "administrative_assistant",
          "admin"
        ] 
        && request.resource.data.status == "pending"; 
    } 
 
    function validRegistrationCreate() { 
      return signedIn() 
        && !exists(registrationPath()) 
        && request.resource.data.userCount == 1 
        && request.resource.data.firstSuperAdminId in [ 
          request.auth.uid, 
          "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        ] 
        && request.resource.data.updatedAt == request.time 
        && request.resource.data.keys().hasOnly([ 
          "userCount", 
          "firstSuperAdminId", 
          "updatedAt" 
        ]); 
    } 
 
    function validRegistrationUpdate() { 
      return signedIn() 
        && exists(registrationPath()) 
        && ( 
          request.resource.data.userCount == resource.data.userCount + 1 
          || ( 
            request.auth.uid == "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
            && request.resource.data.userCount == resource.data.userCount 
          ) 
        ) 
        && request.resource.data.firstSuperAdminId in [ 
          resource.data.firstSuperAdminId, 
          "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        ] 
        && request.resource.data.updatedAt == request.time 
        && request.resource.data.keys().hasOnly([ 
          "userCount", 
          "firstSuperAdminId", 
          "updatedAt" 
        ]); 
    } 

    function validOptionalString(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is string;
    }

    function validOptionalTerm(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] in ["1st Term", "2nd Term", "3rd Term"];
    }

    function validOptionalBool(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is bool;
    }

    function validOptionalTimestamp(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is timestamp;
    }

    function validNotificationToken(userId, tokenId) {
      return request.resource.data.tokenId == tokenId
        && request.resource.data.userId == userId
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.userAgent is string
        && request.resource.data.platform is string
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "tokenId",
          "token",
          "userId",
          "userAgent",
          "platform",
          "enabled",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validNotificationCreate(userId, notificationId) {
      return request.resource.data.notificationId == notificationId
        && request.resource.data.userId == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 600
        && validOptionalString("href")
        && request.resource.data.audience in [
          "all",
          "principal",
          "master_teacher",
          "teacher",
          "registrar",
          "administrative_officer",
          "administrative_assistant",
          "admin",
          "super_admin",
          "user"
        ]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.creatorName is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          "notificationId",
          "userId",
          "title",
          "body",
          "href",
          "audience",
          "createdBy",
          "creatorName",
          "read",
          "createdAt"
        ]);
    }

    function validNotificationReadUpdate(userId, notificationId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid == userId
        && request.resource.data.notificationId == notificationId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.get("href", "") == resource.data.get("href", "")
        && request.resource.data.audience == resource.data.audience
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time
        && changedKeys.hasOnly(["read", "readAt"]);
    }

    function validUserRole(role) {
      return role in [
        "principal",
        "master_teacher",
        "teacher",
        "registrar",
        "administrative_officer",
        "administrative_assistant",
        "admin",
        "super_admin"
      ];
    }

    function validModulePermissions() {
      return request.resource.data.modulePermissions is list
        && request.resource.data.modulePermissions.size() <= 27
        && request.resource.data.modulePermissions.hasOnly([
          "dashboard",
          "loading",
          "teachers",
          "subjects",
          "sections",
          "enrollment",
          "curriculum_mapping",
          "load_assignment",
          "scheduler",
          "dll_submissions",
          "document_requests",
          "tosia_pro",
          "mps",
          "grade_submissions",
          "grade_summary",
          "observations",
          "personnel_attendance",
          "personnel_locator",
          "my_personnel_attendance",
          "teacher_loads",
          "certificates",
          "printable_certificates",
          "reports",
          "personnel_settings",
          "settings",
          "backup_restore",
          "users"
        ]);
    }

    function validDllRequestCreate(requestId) {
      return request.resource.data.requestId == requestId
        && request.resource.data.title is string
        && request.resource.data.schoolYear is string
        && request.resource.data.weekLabel is string
        && request.resource.data.weekStart is string
        && request.resource.data.weekEnd is string
        && request.resource.data.dueDate is string
        && request.resource.data.status in ["active", "closed"]
        && request.resource.data.createdBy == request.auth.uid
        && validOptionalString("instructions")
        && validOptionalTerm("term")
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "requestId",
          "title",
          "schoolYear",
          "term",
          "weekLabel",
          "weekStart",
          "weekEnd",
          "dueDate",
          "instructions",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validDllRequestUpdate(requestId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.requestId == requestId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.title is string
        && request.resource.data.schoolYear is string
        && request.resource.data.weekLabel is string
        && request.resource.data.weekStart is string
        && request.resource.data.weekEnd is string
        && request.resource.data.dueDate is string
        && request.resource.data.status in ["active", "closed"]
        && validOptionalString("instructions")
        && validOptionalTerm("term")
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "title",
          "schoolYear",
          "term",
          "weekLabel",
          "weekStart",
          "weekEnd",
          "dueDate",
          "instructions",
          "status",
          "updatedAt"
        ]);
    }

    function validDllSubmissionCreate(submissionId) {
      return request.resource.data.submissionId == submissionId
        && request.resource.data.requestId is string
        && validOptionalString("schoolYear")
        && validOptionalTerm("term")
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string
        && request.resource.data.subjectId is string
        && request.resource.data.subjectName is string
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submissionType in ["soft_copy", "hard_copy"]
        && request.resource.data.link is string
        && validOptionalString("submittedTo")
        && request.resource.data.status == "submitted"
        && request.resource.data.submittedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "submissionId",
          "requestId",
          "schoolYear",
          "term",
          "teacherId",
          "teacherName",
          "subjectId",
          "subjectName",
          "submittedBy",
          "submissionType",
          "link",
          "submittedTo",
          "status",
          "submittedAt",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validDllSubmissionTeacherUpdate(submissionId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.submissionId == submissionId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.subjectId == resource.data.subjectId
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && validOptionalString("schoolYear")
        && validOptionalTerm("term")
        && request.resource.data.teacherName is string
        && request.resource.data.subjectName is string
        && request.resource.data.submissionType in ["soft_copy", "hard_copy"]
        && request.resource.data.link is string
        && validOptionalString("submittedTo")
        && request.resource.data.status == "submitted"
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "teacherName",
          "subjectName",
          "schoolYear",
          "term",
          "submissionType",
          "link",
          "submittedTo",
          "status",
          "submittedAt",
          "updatedAt"
        ]);
    }

    function validDllSubmissionReview(submissionId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.submissionId == submissionId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.subjectId == resource.data.subjectId
        && request.resource.data.teacherName == resource.data.teacherName
        && request.resource.data.subjectName == resource.data.subjectName
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.submissionType == resource.data.submissionType
        && request.resource.data.link == resource.data.link
        && request.resource.data.get("submittedTo", "") == resource.data.get("submittedTo", "")
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ["submitted", "approved", "returned"]
        && request.resource.data.remarks is string
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewerName is string
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "status",
          "remarks",
          "reviewedBy",
          "reviewerName",
          "reviewedAt",
          "updatedAt"
        ]);
    }

    function validDllSubmissionArchive(submissionId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.submissionId == submissionId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.subjectId == resource.data.subjectId
        && request.resource.data.teacherName == resource.data.teacherName
        && request.resource.data.subjectName == resource.data.subjectName
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.submissionType == resource.data.submissionType
        && request.resource.data.link == resource.data.link
        && request.resource.data.get("submittedTo", "") == resource.data.get("submittedTo", "")
        && request.resource.data.status == resource.data.status
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.archived == true
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "archived",
          "updatedAt"
        ]);
    }

    function validMpsRequestCreate(requestId) {
      return request.resource.data.requestId == requestId
        && request.resource.data.title is string
        && request.resource.data.schoolYear is string
        && request.resource.data.term in ["1st Term", "2nd Term", "3rd Term"]
        && request.resource.data.testName is string
        && request.resource.data.dueDate is string
        && validOptionalString("instructions")
        && request.resource.data.status in ["active", "closed"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.creatorName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "requestId",
          "title",
          "schoolYear",
          "term",
          "testName",
          "dueDate",
          "instructions",
          "status",
          "createdBy",
          "creatorName",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validMpsRequestUpdate(requestId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.requestId == requestId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.title is string
        && request.resource.data.schoolYear is string
        && request.resource.data.term in ["1st Term", "2nd Term", "3rd Term"]
        && request.resource.data.testName is string
        && request.resource.data.dueDate is string
        && validOptionalString("instructions")
        && request.resource.data.status in ["active", "closed"]
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "title",
          "schoolYear",
          "term",
          "testName",
          "dueDate",
          "instructions",
          "status",
          "updatedAt"
        ]);
    }

    function validTosiaRequestCreate(requestId) {
      return request.resource.data.requestId == requestId
        && request.resource.data.title is string
        && request.resource.data.schoolYear is string
        && request.resource.data.term in ["1st Term", "2nd Term", "3rd Term"]
        && request.resource.data.testName is string
        && request.resource.data.dueDate is string
        && validOptionalString("instructions")
        && request.resource.data.status in ["active", "closed"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.creatorName is string

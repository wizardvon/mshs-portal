          "hideInactiveDashboardCards",
          "updatedAt"
        ]);
    }

    function validPersonnelAttendance(attendanceId) {
      return request.resource.data.attendanceId == attendanceId
        && request.resource.data.attendanceDate is string
        && request.resource.data.staffType in ["teaching", "non_teaching"]
        && request.resource.data.staffId is string
        && request.resource.data.staffName is string
        && request.resource.data.roleOrPosition is string
        && request.resource.data.status in ["present", "absent", "official_business"]
        && (
          (
            request.resource.data.status == "absent"
            && request.resource.data.absenceCreditType in [
              "specialOrderServiceCredit",
              "localServiceCredit",
              "wellnessBreak",
              "leaveCredits"
            ]
          )
          || (
            request.resource.data.status != "absent"
            && !request.resource.data.keys().hasAny(["absenceCreditType"])
          )
        )
        && request.resource.data.remarks is string
        && validOptionalString("timeIn")
        && validOptionalString("timeOut")
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.recorderName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "attendanceId",
          "attendanceDate",
          "staffType",
          "staffId",
          "staffName",
          "roleOrPosition",
          "status",
          "absenceCreditType",
          "timeIn",
          "timeOut",
          "remarks",
          "recordedBy",
          "recorderName",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validPersonnelCreditLog(logId) {
      return request.resource.data.logId == logId
        && request.resource.data.staffId is string
        && request.resource.data.staffName is string
        && request.resource.data.staffType in ["teaching", "non_teaching"]
        && request.resource.data.roleOrPosition is string
        && request.resource.data.creditType in [
          "specialOrderServiceCredit",
          "localServiceCredit",
          "wellnessBreak",
          "leaveCredits"
        ]
        && request.resource.data.source in [
          "manual_adjustment",
          "absence_deduction",
          "absence_refund"
        ]
        && request.resource.data.amount is number
        && request.resource.data.previousBalance is number
        && request.resource.data.newBalance is number
        && validOptionalString("attendanceId")
        && validOptionalString("attendanceDate")
        && request.resource.data.remarks is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.creatorName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          "logId",
          "staffId",
          "staffName",
          "staffType",
          "roleOrPosition",
          "creditType",
          "source",
          "amount",
          "previousBalance",
          "newBalance",
          "attendanceId",
          "attendanceDate",
          "remarks",
          "createdBy",
          "creatorName",
          "createdAt"
        ]);
    }

    function canUpdateOwnPersonnelLocation(staffId) {
      return isApprovedUser()
        && (
          staffId == request.auth.uid
          || staffId == currentProfile().data.assignedTeacherId
        );
    }

    function validPersonnelLocation(locationId) {
      return request.resource.data.locationId == locationId
        && request.resource.data.staffId == locationId
        && request.resource.data.staffName is string
        && request.resource.data.staffType in ["teaching", "non_teaching"]
        && request.resource.data.roleOrPosition is string
        && request.resource.data.status in ["available", "on_leave", "official_business"]
        && request.resource.data.currentLocation is string
        && validOptionalString("note")
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updaterName is string
        && validOptionalTimestamp("createdAt")
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "locationId",
          "staffId",
          "staffName",
          "staffType",
          "roleOrPosition",
          "status",
          "currentLocation",
          "note",
          "updatedBy",
          "updaterName",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validPersonnelCreditBalance(creditId) {
      return request.resource.data.creditId == creditId
        && request.resource.data.staffId is string
        && request.resource.data.staffName is string
        && request.resource.data.staffType in ["teaching", "non_teaching"]
        && request.resource.data.roleOrPosition is string
        && request.resource.data.specialOrderServiceCredit is number
        && request.resource.data.localServiceCredit is number
        && request.resource.data.wellnessBreak is number
        && request.resource.data.leaveCredits is number
        && validOptionalString("remarks")
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updaterName is string
        && validOptionalTimestamp("createdAt")
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "creditId",
          "staffId",
          "staffName",
          "staffType",
          "roleOrPosition",
          "specialOrderServiceCredit",
          "localServiceCredit",
          "wellnessBreak",
          "leaveCredits",
          "remarks",
          "updatedBy",
          "updaterName",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validObservationScheduleBase(observationId) {
      return request.resource.data.observationId == observationId
        && request.resource.data.schoolYear is string
        && request.resource.data.term in ["1st Term", "2nd Term", "3rd Term"]
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string
        && request.resource.data.observerId is string
        && request.resource.data.observerName is string
        && request.resource.data.activityType in ["classroom_observation", "coaching_mentoring"]
        && request.resource.data.scheduleDate is string
        && request.resource.data.day in ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.status in ["scheduled", "done", "cancelled"]
        && request.resource.data.createdBy is string
        && validOptionalString("observationType")
        && validOptionalString("observerRole")
        && validOptionalString("subjectId")
        && validOptionalString("subjectName")
        && validOptionalString("sectionId")
        && validOptionalString("sectionName")
        && validOptionalString("room")
        && validOptionalString("notes")
        && validOptionalTimestamp("completedAt")
        && request.resource.data.keys().hasOnly([
          "observationId",
          "schoolYear",
          "term",
          "teacherId",
          "teacherName",
          "observerId",
          "observerName",
          "observerRole",
          "activityType",
          "observationType",
          "scheduleDate",
          "day",
          "startTime",
          "endTime",
          "subjectId",
          "subjectName",
          "sectionId",
          "sectionName",
          "room",
          "notes",
          "status",
          "completedAt",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validObservationScheduleCreate(observationId) {
      return validObservationScheduleBase(observationId)
        && request.resource.data.observerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "scheduled"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validObservationScheduleUpdate(observationId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return validObservationScheduleBase(observationId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.observerId == resource.data.observerId
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly(["status", "completedAt", "updatedAt"]);
    }
 
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isApprovedUser() || isApprovedAdmin() || canManagePersonnelAttendance() || canUseDocumentRequests());
      allow create: if validFirstUser(userId) || validBootstrapUser(userId) || validPendingUser(userId);
      allow update: if (isSuperAdmin() && validUserProfileWrite(userId)) || validBootstrapUser(userId);
      allow delete: if isSuperAdmin();

      match /notificationTokens/{tokenId} {
        allow read: if isApprovedUser()
          && (request.auth.uid == userId || isApprovedAdmin());
        allow create, update: if isApprovedUser()
          && request.auth.uid == userId
          && validNotificationToken(userId, tokenId);
        allow delete: if isApprovedUser()
          && (request.auth.uid == userId || isApprovedAdmin());
      }

      match /notifications/{notificationId} {
        allow read: if isApprovedUser()
          && (request.auth.uid == userId || isApprovedAdmin());
        allow create: if isApprovedAdmin()
          && validNotificationCreate(userId, notificationId);
        allow update: if isApprovedUser()
          && validNotificationReadUpdate(userId, notificationId);
        allow delete: if isApprovedUser()
          && (request.auth.uid == userId || isApprovedAdmin());
      }
    }

    match /system/{docId} { 
      allow get: if (signedIn() && docId == "registration") || isApprovedAdmin(); 
      allow list: if isApprovedAdmin(); 
      allow create: if docId == "registration" && validRegistrationCreate(); 
      allow update: if docId == "registration" && validRegistrationUpdate(); 
    } 

    match /classSchedules/{scheduleId} {
      allow read: if signedIn() && currentProfile().data.status == "approved";
      allow create, update: if isApprovedAdmin() && validClassSchedule(scheduleId);
      allow delete: if isApprovedAdmin();
    }

    match /savedSchedules/{savedScheduleId} {
      allow read: if signedIn() && currentProfile().data.status == "approved";
      allow create: if isApprovedAdmin() && validSavedSchedule(savedScheduleId);
      allow update, delete: if isApprovedAdmin();
    }

    match /appSettings/{settingId} {
      allow read: if signedIn() && currentProfile().data.status == "approved";
      allow create, update: if isApprovedAdmin()
        && settingId == "schedulePrint"
        && validSchedulePrintSettings();
      allow create, update: if isSuperAdmin()
        && settingId == "academic"
        && validAcademicSettings();
      allow delete: if false;
    }

    match /userSettings/{userId} {
      allow read: if isApprovedUser()
        && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isApprovedUser()
        && request.auth.uid == userId
        && request.resource.data.hideInactiveDashboardCards is bool
        && request.resource.data.theme in [
          "mshs_classic",
          "academic_blue",
          "dark_mode",
          "high_contrast"
        ]
        && request.resource.data.density in [
          "comfortable",
          "compact"
        ]
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "hideInactiveDashboardCards",
          "theme",
          "density",
          "updatedAt"
        ]);
      allow delete: if false;
    }

    match /dllRequests/{requestId} {
      allow read: if isApprovedUser();
      allow create: if canManageDllRequests() && validDllRequestCreate(requestId);
      allow update: if canManageDllRequests() && validDllRequestUpdate(requestId);
      allow delete: if isSuperAdmin();
    }

    match /dllSubmissions/{submissionId} {
      allow read: if isDllReviewer()
        || (
          canSubmitForTeacher(resource.data.teacherId)
        );
      allow create: if canSubmitForTeacher(request.resource.data.teacherId)
        && validDllSubmissionCreate(submissionId);
      allow update: if (
          canSubmitForTeacher(resource.data.teacherId)
          && validDllSubmissionTeacherUpdate(submissionId)
        ) || (
          isDllReviewer()
          && validDllSubmissionReview(submissionId)
        ) || (
          isSuperAdmin()
          && validDllSubmissionArchive(submissionId)
        );
      allow delete: if isSuperAdmin();
    }

    match /documentRequests/{requestId} {
      allow read: if canUseDocumentRequests();
      allow create, update: if canUseDocumentRequests();
      allow delete: if isSuperAdmin();
    }

    match /documentRequestSubmissions/{submissionId} {
      allow read, create, update: if canUseDocumentRequests();
      allow delete: if isSuperAdmin();
    }

    match /mpsRequests/{requestId} {
      allow read: if isApprovedUser();
      allow create: if isMpsReviewer() && validMpsRequestCreate(requestId);
      allow update: if isMpsReviewer() && validMpsRequestUpdate(requestId);
      allow delete: if isSuperAdmin();
    }

    match /mpsSubmissions/{submissionId} {
      allow read: if isMpsReviewer()
        || (
          canSubmitForTeacher(resource.data.teacherId)
        );
      allow create: if canSubmitForTeacher(request.resource.data.teacherId)
        && validMpsSubmissionCreate(submissionId);
      allow update: if canSubmitForTeacher(resource.data.teacherId)
        && validMpsSubmissionTeacherUpdate(submissionId);
      allow delete: if isSuperAdmin();
    }

    match /tosiaRequests/{requestId} {
      allow read: if isApprovedUser();
      allow create: if isTosiaReviewer() && validTosiaRequestCreate(requestId);
      allow update: if isTosiaReviewer() && validTosiaRequestUpdate(requestId);
      allow delete: if isSuperAdmin();
    }

    match /tosiaAssessments/{assessmentId} {
      allow read: if isTosiaReviewer()
        || (
          canSubmitForTeacher(resource.data.teacherId)
        ) || (
          isApprovedUser()
          && currentProfile().data.role in ["teacher", "master_teacher"]
        );
      allow create: if (
          canSubmitForTeacher(request.resource.data.teacherId)
          || isTosiaReviewer()
        )
        && hasActiveTosiaRequest(request.resource.data)
        && request.resource.data.assessmentId == assessmentId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (
          canSubmitForTeacher(resource.data.teacherId)
          || isTosiaReviewer()
        )
        && request.resource.data.requestId == resource.data.requestId
        && hasActiveTosiaRequest(request.resource.data)
        && request.resource.data.assessmentId == assessmentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSuperAdmin();
    }

    match /gradeSubmissions/{gradeSubmissionId} {
      allow read: if canSubmitForTeacher(resource.data.teacherId)
        || canViewGradeSummary(resource.data);
      allow create: if canSubmitForTeacher(request.resource.data.teacherId)
        && validGradeSubmissionCreate(gradeSubmissionId);
      allow update: if canSubmitForTeacher(resource.data.teacherId)
        && canSubmitForTeacher(request.resource.data.teacherId)
        && validGradeSubmissionUpdate(gradeSubmissionId);
      allow delete: if isSuperAdmin();
    }

    match /gradeComputations/{computationId} {
      allow read: if canSubmitForTeacher(resource.data.teacherId)
        || canViewGradeSummary(resource.data);
      allow create: if validGradeComputationCreate(computationId);
      allow update: if validGradeComputationUpdate(computationId);
      allow delete: if isSuperAdmin();
    }

    match /gradeComputationSettings/{settingsId} {
      allow read: if canSubmitForTeacher(resource.data.teacherId)
        || canViewGradeSummary(resource.data);
      allow create: if validGradeComputationSettingsCreate(settingsId);
      allow update: if validGradeComputationSettingsUpdate(settingsId);
      allow delete: if isSuperAdmin();
    }

    match /observationSchedules/{observationId} {
      allow read: if isObservationReviewer()
        || (
          isApprovedUser()
          && currentProfile().data.role == "teacher"
          && currentProfile().data.assignedTeacherId == resource.data.teacherId
        );
      allow create: if isObservationReviewer()
        && validObservationScheduleCreate(observationId);
      allow update: if isObservationReviewer()
        && (resource.data.observerId == request.auth.uid || isSuperAdmin())
        && validObservationScheduleUpdate(observationId);
      allow delete: if isSuperAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if canReadAnnouncementData(resource.data);
      allow create: if validAnnouncementCreate(announcementId);
      allow update: if (
          resource.data.postedByUid == request.auth.uid
          && validAnnouncementOwnerUpdate(announcementId)
        ) || (
          isAnnouncementManager()
          && validAnnouncementManagerUpdate(announcementId)
        );
      allow delete: if isAnnouncementManager()
        || (
          isApprovedUser()
          && resource.data.postedByUid == request.auth.uid
          && resource.data.status == "draft"
        );
    }

    match /announcementReads/{readId} {
      allow get: if canReadAnnouncementRead(resource.data);
      allow list: if isApprovedUser()
        && resource.data.userId == request.auth.uid;
      allow list: if isAnnouncementManager()
        || (
          isApprovedUser()
          && announcementForRead(resource.data).data.postedByUid == request.auth.uid
        );
      allow create: if validAnnouncementReadCreate(readId);
      allow update: if validAnnouncementReadUpdate();
      allow delete: if isAnnouncementManager();
    }

    match /personnelAttendance/{attendanceId} {
      allow read: if isApprovedUser();
      allow create, update: if canManagePersonnelAttendance()
        && validPersonnelAttendance(attendanceId);
      allow delete: if canManagePersonnelAttendance();
    }

    match /personnelLocations/{locationId} {
      allow read: if isApprovedUser();
      allow create, update: if canUpdateOwnPersonnelLocation(locationId)
        && validPersonnelLocation(locationId);
      allow delete: if isSuperAdmin();
    }

    match /personnelCredits/{creditId} {
      allow read: if canManagePersonnelAttendance()
        || (
          isApprovedUser()
          && (
            resource.data.staffId == request.auth.uid
            || resource.data.staffId == currentProfile().data.assignedTeacherId
          )
        );
      allow create, update: if canManagePersonnelAttendance()
        && validPersonnelCreditBalance(creditId);
      allow delete: if isSuperAdmin();
    }

    match /personnelCreditLogs/{logId} {
      allow read: if canManagePersonnelAttendance();
      allow create: if canManagePersonnelAttendance()
        && validPersonnelCreditLog(logId);
      allow update, delete: if false;
    }

    match /enrollmentStudents/{enrollmentId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if canManageEnrollment();
    }

    match /classEnrollments/{classEnrollmentId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if canManageEnrollment();
    }

    match /certificates/{certificateId} {
      allow get: if (resource.data.publicAccess == true) || isApprovedUser();
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /certificateParticipants/{participantId} {
      allow get: if resource.data.publicAccess == true
        || isSuperAdmin()
        || (
          isApprovedUser()
          && (
            resource.data.participantUserId == request.auth.uid
            || (
              currentProfile().data.assignedTeacherId is string
              && resource.data.participantStaffId == currentProfile().data.assignedTeacherId
            )
          )
        );
      allow list: if isSuperAdmin()
        || (
          isApprovedUser()
          && (
            resource.data.participantUserId == request.auth.uid
            || (
              currentProfile().data.assignedTeacherId is string
              && resource.data.participantStaffId == currentProfile().data.assignedTeacherId
            )
          )
        );
      allow create, update, delete: if isSuperAdmin();
    }

    match /certificatePeople/{personId} {
      allow read, create, update, delete: if isSuperAdmin();
    }
 
    match /{loadingCollection}/{recordId} { 
      allow read: if signedIn() 
        && currentProfile().data.status == "approved" 
        && loadingCollection in [ 
          "teachers", 
          "subjects", 
          "sections", 
          "curriculumMappings", 
          "loadAssignments",
          "ancillaryLoads" 
        ]; 
 
      allow create, update: if (
          isApprovedAdmin()
          || (canManageEnrollment() && loadingCollection in ["sections", "curriculumMappings"])
        )
        && loadingCollection in [ 
          "teachers", 
          "subjects", 
          "sections", 
          "curriculumMappings", 
          "loadAssignments",
          "ancillaryLoads" 
        ]; 

      allow delete: if isApprovedAdmin()
        && loadingCollection in [
          "teachers",
          "subjects",
          "sections",
          "curriculumMappings",
          "loadAssignments",
          "ancillaryLoads"
        ];
    } 
  } 
} 

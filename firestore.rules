rules_version = '2'; 
 
service cloud.firestore { 
  match /databases/{database}/documents { 
    function registrationPath() { 
      return /databases/$(database)/documents/system/registration; 
    } 
 
    function signedIn() { 
      return request.auth != null; 
    } 
 
    function currentProfile() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)); 
    } 
 
    function isApprovedAdmin() { 
      return signedIn() 
        && currentProfile().data.status == "approved" 
        && currentProfile().data.role in ["super_admin", "admin"]; 
    } 
 
    function isSuperAdmin() { 
      return signedIn() 
        && currentProfile().data.status == "approved" 
        && currentProfile().data.role == "super_admin"; 
    } 

    function isApprovedUser() {
      return signedIn()
        && currentProfile().data.status == "approved";
    }

    function isDllReviewer() {
      return isApprovedUser()
        && currentProfile().data.role in ["super_admin", "principal", "master_teacher"];
    }
 
    function isBootstrapSuperAdmin(userId) { 
      return signedIn() 
        && request.auth.uid == "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        && userId == "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        && request.resource.data.email == "wizardvon@gmail.com"; 
    } 
 
    function validUserBase(userId) { 
      return signedIn() 
        && request.auth.uid == userId 
        && request.resource.data.userId == userId 
        && request.resource.data.email is string 
        && request.resource.data.fullName is string 
        && validUserRole(request.resource.data.role)
        && validModulePermissions()
        && request.resource.data.createdAt == request.time 
        && request.resource.data.keys().hasOnly([ 
          "userId", 
          "fullName", 
          "email", 
          "role", 
          "status", 
          "modulePermissions",
          "createdAt" 
        ]); 
    } 
 
    function validFirstUser(userId) { 
      return validUserBase(userId) 
        && !exists(registrationPath()) 
        && request.resource.data.role == "super_admin" 
        && request.resource.data.status == "approved"; 
    } 
 
    function validBootstrapUser(userId) { 
      return signedIn() 
        && isBootstrapSuperAdmin(userId) 
        && request.resource.data.userId == userId 
        && request.resource.data.fullName is string 
        && request.resource.data.createdAt is timestamp 
        && request.resource.data.role == "super_admin" 
        && request.resource.data.status == "approved" 
        && validModulePermissions()
        && request.resource.data.keys().hasOnly([ 
          "userId", 
          "fullName", 
          "email", 
          "role", 
          "status", 
          "modulePermissions",
          "createdAt" 
        ]); 
    } 
 
    function validPendingUser(userId) { 
      return validUserBase(userId) 
        && exists(registrationPath()) 
        && request.resource.data.role in [
          "principal",
          "master_teacher",
          "teacher",
          "registrar",
          "administrative_officer",
          "administrative_assistant",
          "admin"
        ] 
        && request.resource.data.status == "pending"; 
    } 
 
    function validRegistrationCreate() { 
      return signedIn() 
        && !exists(registrationPath()) 
        && request.resource.data.userCount == 1 
        && request.resource.data.firstSuperAdminId in [ 
          request.auth.uid, 
          "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        ] 
        && request.resource.data.updatedAt == request.time 
        && request.resource.data.keys().hasOnly([ 
          "userCount", 
          "firstSuperAdminId", 
          "updatedAt" 
        ]); 
    } 
 
    function validRegistrationUpdate() { 
      return signedIn() 
        && exists(registrationPath()) 
        && ( 
          request.resource.data.userCount == resource.data.userCount + 1 
          || ( 
            request.auth.uid == "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
            && request.resource.data.userCount == resource.data.userCount 
          ) 
        ) 
        && request.resource.data.firstSuperAdminId in [ 
          resource.data.firstSuperAdminId, 
          "fTHaa7C31vSL8XZuPeXbEEtc23F3" 
        ] 
        && request.resource.data.updatedAt == request.time 
        && request.resource.data.keys().hasOnly([ 
          "userCount", 
          "firstSuperAdminId", 
          "updatedAt" 
        ]); 
    } 

    function validOptionalString(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is string;
    }

    function validOptionalBool(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is bool;
    }

    function validOptionalTimestamp(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is timestamp;
    }

    function validUserRole(role) {
      return role in [
        "principal",
        "master_teacher",
        "teacher",
        "registrar",
        "administrative_officer",
        "administrative_assistant",
        "admin",
        "super_admin"
      ];
    }

    function validModulePermissions() {
      return request.resource.data.modulePermissions is list
        && request.resource.data.modulePermissions.size() <= 14
        && request.resource.data.modulePermissions.hasOnly([
          "dashboard",
          "loading",
          "teachers",
          "subjects",
          "sections",
          "curriculum_mapping",
          "load_assignment",
          "scheduler",
          "dll_submissions",
          "teacher_loads",
          "reports",
          "settings",
          "backup_restore",
          "users"
        ]);
    }

    function validDllRequestCreate(requestId) {
      return request.resource.data.requestId == requestId
        && request.resource.data.title is string
        && request.resource.data.schoolYear is string
        && request.resource.data.weekLabel is string
        && request.resource.data.weekStart is string
        && request.resource.data.weekEnd is string
        && request.resource.data.dueDate is string
        && request.resource.data.status in ["active", "closed"]
        && request.resource.data.createdBy == request.auth.uid
        && validOptionalString("instructions")
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "requestId",
          "title",
          "schoolYear",
          "weekLabel",
          "weekStart",
          "weekEnd",
          "dueDate",
          "instructions",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validDllRequestUpdate(requestId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.requestId == requestId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.title is string
        && request.resource.data.schoolYear is string
        && request.resource.data.weekLabel is string
        && request.resource.data.weekStart is string
        && request.resource.data.weekEnd is string
        && request.resource.data.dueDate is string
        && request.resource.data.status in ["active", "closed"]
        && validOptionalString("instructions")
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "title",
          "schoolYear",
          "weekLabel",
          "weekStart",
          "weekEnd",
          "dueDate",
          "instructions",
          "status",
          "updatedAt"
        ]);
    }

    function validDllSubmissionCreate(submissionId) {
      return request.resource.data.submissionId == submissionId
        && request.resource.data.requestId is string
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string
        && request.resource.data.subjectId is string
        && request.resource.data.subjectName is string
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submissionType in ["soft_copy", "hard_copy"]
        && request.resource.data.link is string
        && request.resource.data.status == "submitted"
        && request.resource.data.submittedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "submissionId",
          "requestId",
          "teacherId",
          "teacherName",
          "subjectId",
          "subjectName",
          "submittedBy",
          "submissionType",
          "link",
          "status",
          "submittedAt",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validDllSubmissionTeacherUpdate(submissionId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.submissionId == submissionId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.subjectId == resource.data.subjectId
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.teacherName is string
        && request.resource.data.subjectName is string
        && request.resource.data.submissionType in ["soft_copy", "hard_copy"]
        && request.resource.data.link is string
        && request.resource.data.status == "submitted"
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "teacherName",
          "subjectName",
          "submissionType",
          "link",
          "status",
          "submittedAt",
          "updatedAt"
        ]);
    }

    function validDllSubmissionReview(submissionId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.submissionId == submissionId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.subjectId == resource.data.subjectId
        && request.resource.data.teacherName == resource.data.teacherName
        && request.resource.data.subjectName == resource.data.subjectName
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.submissionType == resource.data.submissionType
        && request.resource.data.link == resource.data.link
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ["submitted", "approved", "returned"]
        && request.resource.data.remarks is string
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewerName is string
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "status",
          "remarks",
          "reviewedBy",
          "reviewerName",
          "reviewedAt",
          "updatedAt"
        ]);
    }

    function validDllSubmissionArchive(submissionId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.submissionId == submissionId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.subjectId == resource.data.subjectId
        && request.resource.data.teacherName == resource.data.teacherName
        && request.resource.data.subjectName == resource.data.subjectName
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.submissionType == resource.data.submissionType
        && request.resource.data.link == resource.data.link
        && request.resource.data.status == resource.data.status
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.archived == true
        && request.resource.data.updatedAt == request.time
        && changedKeys.hasOnly([
          "archived",
          "updatedAt"
        ]);
    }

    function validOptionalNullableString(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is string
        || request.resource.data[fieldName] == null;
    }

    function validUserProfileWrite(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.userId == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.fullName == resource.data.fullName
        && request.resource.data.createdAt == resource.data.createdAt
        && validUserRole(request.resource.data.role)
        && request.resource.data.status in ["approved", "pending", "disabled"]
        && validModulePermissions()
        && validOptionalTimestamp("reviewedAt")
        && validOptionalString("reviewedBy")
        && validOptionalNullableString("assignedTeacherId")
        && validOptionalNullableString("advisingSectionId")
        && changedKeys.hasOnly([
          "role",
          "status",
          "modulePermissions",
          "assignedTeacherId",
          "advisingSectionId",
          "reviewedAt",
          "reviewedBy"
        ]);
    }

    function validClassSchedule(scheduleId) {
      return request.resource.data.scheduleId == scheduleId
        && request.resource.data.schoolYear is string
        && request.resource.data.term in ["1st Term", "2nd Term", "3rd Term"]
        && request.resource.data.gradeLevel is string
        && request.resource.data.strand is string
        && request.resource.data.sectionId is string
        && request.resource.data.subjectId is string
        && request.resource.data.teacherId is string
        && request.resource.data.day in ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.duration is number
        && request.resource.data.duration > 0
        && request.resource.data.slotId is string
        && request.resource.data.sourceAssignmentId is string
        && validOptionalString("room")
        && validOptionalBool("locked")
        && validOptionalString("templateType")
        && validOptionalTimestamp("createdAt")
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "scheduleId",
          "schoolYear",
          "term",
          "gradeLevel",
          "strand",
          "sectionId",
          "subjectId",
          "teacherId",
          "room",
          "day",
          "startTime",
          "endTime",
          "duration",
          "slotId",
          "sourceAssignmentId",
          "locked",
          "templateType",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validSavedSchedule(savedScheduleId) {
      return request.resource.data.savedScheduleId == savedScheduleId
        && request.resource.data.name is string
        && request.resource.data.schoolYear is string
        && request.resource.data.term in ["1st Term", "2nd Term", "3rd Term"]
        && request.resource.data.gradeLevel is string
        && request.resource.data.strand is string
        && request.resource.data.entries is list
        && request.resource.data.entryCount == request.resource.data.entries.size()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validOptionalString("createdBy")
        && request.resource.data.keys().hasOnly([
          "savedScheduleId",
          "name",
          "schoolYear",
          "term",
          "gradeLevel",
          "strand",
          "entries",
          "entryCount",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validSignatoryGroup(groupName) {
      return request.resource.data[groupName] is map
        && request.resource.data[groupName].keys().hasOnly([
          "preparedBy",
          "checkedBy",
          "notedBy"
        ])
        && request.resource.data[groupName].preparedBy is map
        && request.resource.data[groupName].preparedBy.name is string
        && request.resource.data[groupName].preparedBy.position is string
        && request.resource.data[groupName].preparedBy.keys().hasOnly(["name", "position"])
        && request.resource.data[groupName].checkedBy is map
        && request.resource.data[groupName].checkedBy.name is string
        && request.resource.data[groupName].checkedBy.position is string
        && request.resource.data[groupName].checkedBy.keys().hasOnly(["name", "position"])
        && request.resource.data[groupName].notedBy is map
        && request.resource.data[groupName].notedBy.name is string
        && request.resource.data[groupName].notedBy.position is string
        && request.resource.data[groupName].notedBy.keys().hasOnly(["name", "position"]);
    }

    function validSchedulePrintSettings() {
      return validSignatoryGroup("classSchedule")
        && validSignatoryGroup("teacherSchedule")
        && request.resource.data.scheduleTimeSlots is map
        && request.resource.data.scheduleTimeSlots.keys().hasOnly([
          "grade11Academic",
          "grade11TechPro",
          "grade12"
        ])
        && request.resource.data.scheduleTimeSlots.grade11Academic is list
        && request.resource.data.scheduleTimeSlots.grade11TechPro is list
        && request.resource.data.scheduleTimeSlots.grade12 is list
        && request.resource.data.scheduleBreaks is map
        && request.resource.data.scheduleBreaks.keys().hasOnly([
          "grade11Academic",
          "grade11TechPro",
          "grade12"
        ])
        && request.resource.data.scheduleBreaks.grade11Academic is list
        && request.resource.data.scheduleBreaks.grade11TechPro is list
        && request.resource.data.scheduleBreaks.grade12 is list
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "classSchedule",
          "teacherSchedule",
          "scheduleTimeSlots",
          "scheduleBreaks",
          "updatedAt"
        ]);
    }
 
    match /users/{userId} { 
      allow read: if signedIn() && (request.auth.uid == userId || isApprovedAdmin()); 
      allow create: if validFirstUser(userId) || validBootstrapUser(userId) || validPendingUser(userId); 
      allow update: if (isSuperAdmin() && validUserProfileWrite(userId)) || validBootstrapUser(userId); 
      allow delete: if isSuperAdmin(); 
    } 
 
    match /system/{docId} { 
      allow get: if (signedIn() && docId == "registration") || isApprovedAdmin(); 
      allow list: if isApprovedAdmin(); 
      allow create: if docId == "registration" && validRegistrationCreate(); 
      allow update: if docId == "registration" && validRegistrationUpdate(); 
    } 

    match /classSchedules/{scheduleId} {
      allow read: if signedIn() && currentProfile().data.status == "approved";
      allow create, update: if isApprovedAdmin() && validClassSchedule(scheduleId);
      allow delete: if isApprovedAdmin();
    }

    match /savedSchedules/{savedScheduleId} {
      allow read: if signedIn() && currentProfile().data.status == "approved";
      allow create: if isApprovedAdmin() && validSavedSchedule(savedScheduleId);
      allow update, delete: if isApprovedAdmin();
    }

    match /appSettings/{settingId} {
      allow read: if signedIn() && currentProfile().data.status == "approved";
      allow create, update: if isApprovedAdmin()
        && settingId == "schedulePrint"
        && validSchedulePrintSettings();
      allow delete: if false;
    }

    match /dllRequests/{requestId} {
      allow read: if isApprovedUser();
      allow create: if isSuperAdmin() && validDllRequestCreate(requestId);
      allow update: if isSuperAdmin() && validDllRequestUpdate(requestId);
      allow delete: if isSuperAdmin();
    }

    match /dllSubmissions/{submissionId} {
      allow read: if isDllReviewer()
        || (
          isApprovedUser()
          && currentProfile().data.role == "teacher"
          && currentProfile().data.assignedTeacherId == resource.data.teacherId
        );
      allow create: if isApprovedUser()
        && currentProfile().data.role == "teacher"
        && currentProfile().data.assignedTeacherId == request.resource.data.teacherId
        && validDllSubmissionCreate(submissionId);
      allow update: if (
          isApprovedUser()
          && currentProfile().data.role == "teacher"
          && currentProfile().data.assignedTeacherId == resource.data.teacherId
          && validDllSubmissionTeacherUpdate(submissionId)
        ) || (
          isDllReviewer()
          && validDllSubmissionReview(submissionId)
        ) || (
          isSuperAdmin()
          && validDllSubmissionArchive(submissionId)
        );
      allow delete: if isSuperAdmin();
    }
 
    match /{loadingCollection}/{recordId} { 
      allow read: if signedIn() 
        && currentProfile().data.status == "approved" 
        && loadingCollection in [ 
          "teachers", 
          "subjects", 
          "sections", 
          "curriculumMappings", 
          "loadAssignments",
          "ancillaryLoads" 
        ]; 
 
      allow create, update, delete: if isApprovedAdmin() 
        && loadingCollection in [ 
          "teachers", 
          "subjects", 
          "sections", 
          "curriculumMappings", 
          "loadAssignments",
          "ancillaryLoads" 
        ]; 
    } 
  } 
} 
